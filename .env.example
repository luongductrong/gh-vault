# Database (Turso)
DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# GitHub (Fine-grained PAT)
# Required permissions: Administration (R/W), Contents (R/W), Metadata (Read)
# Repository access: All repositories
GITHUB_PAT="github_pat_..."
GITHUB_OWNER="your-github-username"
# organizations: O | personal: P (default is P)
GITHUB_OWNER_TYPE="P"

# Cloudflare R2 (optional; enables the built-in R2 bucket)
# Use an R2 S3 API token's Access Key ID and Secret Access Key.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Optional until a custom public domain is configured for the bucket
R2_PUBLIC_BASE_URL="https://assets.example.com"

# App Auth
APP_PASSWORD="your-secure-password"
APP_JWT_SECRET="generate-a-random-64-char-hex-string"
